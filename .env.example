# InsightXPro Wholesale API Credentials 
INSIGHTXPRO_API_KEY=isk_live_your_insightxpro_api_key_here
INSIGHTXPRO_BASE_URL=https://api.insightxpro.store

# Database Configuration (Heroku PostgreSQL / AWS RDS)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional: Neon URL for historical migration script (scripts/migrate-from-neon.ts)
# OLD_NEON_DATABASE_URL=postgresql://user:password@ep-xxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# App Configuration
APP_URL=https://pixelstore.id
PROFIT_MARGIN_PERCENT=15

# Admin Authorization
ADMIN_SECRET_PIN=888888
ADMIN_SECRET_KEY=pixel_store_secure_admin_jwt_session_2026

# SumoPod Payment Gateway (QRIS)
SUMOPOD_API_KEY=your_sumopod_api_key_here
SUMOPOD_BASE_URL=https://api-pay-sandbox.sumopod.com
SUMOPOD_SIGNING_SECRET=whsec_your_signing_secret_here
SUMOPOD_WEBHOOK_TOKEN=whtok_your_webhook_token_here
# SMTP Email System (Sumopod / Custom SMTP)
SMTP_HOST=smtp.sumopod.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Pixel Store <no-reply@pixelstore.oktaa.my.id>"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Telegram Customer Service Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here
