---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Pembayaran Terkonfirmasi — Pixel Store">
  <div class="min-h-[70vh] flex items-center justify-center p-4">
    <div class="max-w-md w-full p-8 bg-white dark:bg-[#141416] border border-zinc-200 dark:border-zinc-800 rounded-3xl text-center space-y-4 shadow-sm animate-in zoom-in-95 duration-200">
      <div class="w-16 h-16 bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 rounded-2xl flex items-center justify-center mx-auto shadow-xs">
        <svg class="w-8 h-8 animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </div>

      <div class="space-y-1">
        <h2 class="text-lg font-black text-zinc-900 dark:text-white">Pembayaran Diterima</h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
          Terima kasih! Transaksi Anda telah berhasil diproses oleh sistem.
        </p>
      </div>

      <div class="pt-2 space-y-2">
        <a
          href="/user"
          class="w-full py-3 px-4 bg-zinc-900 hover:bg-zinc-800 dark:bg-white dark:hover:bg-zinc-100 text-white dark:text-zinc-900 font-bold rounded-xl text-xs transition block shadow-xs"
        >
          Buka Dashboard & Lihat Lisensi ↗
        </a>
        <a
          href="/"
          class="w-full py-2.5 px-4 text-xs font-semibold text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition block"
        >
          Kembali ke Halaman Utama
        </a>
      </div>
    </div>
  </div>

  <script>
    // Auto redirect after 3 seconds
    setTimeout(() => {
      window.location.href = '/user';
    }, 3000);
  </script>
</Layout>
